# Copy to ~/.config/inbox-agent/env and chmod 600 it.
# The bot reads this file itself, and the systemd unit reads it too.
# Fill in ONE of the two, matching claude_backend in config.json.

# backend "code": make this on a machine with a browser:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# backend "api": from console.anthropic.com
ANTHROPIC_API_KEY=
